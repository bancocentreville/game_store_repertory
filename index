<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game Store Catalog</title>

  <!-- React + ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>

  <!-- Babel for JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #0f1115;
      color: #eaeaea;
      margin: 0;
      padding: 24px;
    }
    h1, h2 { margin: 0 0 12px; }
    .container { max-width: 1200px; margin: auto; }
    .controls, .admin-add {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    button {
      background: #1f2937;
      color: #fff;
      border: 1px solid #374151;
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
    }
    button.active {
      background: #2563eb;
      border-color: #2563eb;
    }
    input {
      background: #111827;
      border: 1px solid #374151;
      color: #fff;
      padding: 8px;
      border-radius: 6px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
    }
    .card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 14px;
      padding: 14px;
    }
    .price {
      font-weight: 600;
      margin-top: 6px;
    }
    .muted {
      color: #9ca3af;
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useMemo, useEffect } = React;

    const INITIAL_CATALOG = [
      { id: 1, title: "Bayonetta", console: "PlayStation 3", price: 29.99 },
      { id: 2, title: "Castlevania: Lords of Shadow", console: "PlayStation 3", price: 34.99 },
      { id: 3, title: "Final Fantasy XIII-2", console: "PlayStation 3", price: 24.99 },
      { id: 4, title: "Halo: Combat Evolved", console: "Xbox", price: 19.99 },
      { id: 5, title: "Hitman HD Trilogy", console: "PlayStation 3", price: 39.99 },
      { id: 6, title: "Super Mario Sunshine", console: "GameCube", price: 89.99 },
    ];

    const CONSOLES = ["All", "PlayStation 3", "Xbox", "GameCube"];

    function App() {
      const [catalog, setCatalog] = useState(() => {
        const saved = localStorage.getItem("catalog");
        return saved ? JSON.parse(saved) : INITIAL_CATALOG;
      });

      const [admin, setAdmin] = useState(false);
      const [filter, setFilter] = useState("All");
      const [search, setSearch] = useState("");
      const [newGame, setNewGame] = useState({
        title: "",
        console: "",
        price: ""
      });

      useEffect(() => {
        localStorage.setItem("catalog", JSON.stringify(catalog));
      }, [catalog]);

      const filtered = useMemo(() => {
        return catalog
          .filter(g => filter === "All" || g.console === filter)
          .filter(g => g.title.toLowerCase().includes(search.toLowerCase()))
          .sort((a, b) => a.title.localeCompare(b.title));
      }, [catalog, filter, search]);

      const grouped = useMemo(() => {
        return filtered.reduce((acc, g) => {
          const letter = g.title[0].toUpperCase();
          acc[letter] = acc[letter] || [];
          acc[letter].push(g);
          return acc;
        }, {});
      }, [filtered]);

      const updatePrice = (id, price) => {
        setCatalog(catalog.map(g =>
          g.id === id ? { ...g, price } : g
        ));
      };

      const addGame = () => {
        if (!newGame.title || !newGame.console || !newGame.price) return;

        setCatalog([
          ...catalog,
          {
            id: Date.now(),
            title: newGame.title,
            console: newGame.console,
            price: parseFloat(newGame.price)
          }
        ]);

        setNewGame({ title: "", console: "", price: "" });
      };

      return (
        <div className="container">
          <h1>Game Store Catalog</h1>

          <div className="controls">
            <button
              onClick={() => setAdmin(!admin)}
              className={admin ? "active" : ""}
            >
              Admin
            </button>

            {CONSOLES.map(c => (
              <button
                key={c}
                onClick={() => setFilter(c)}
                className={filter === c ? "active" : ""}
              >
                {c}
              </button>
            ))}

            <input
              placeholder="Search…"
              value={search}
              onChange={e => setSearch(e.target.value)}
            />
          </div>

          {admin && (
            <div className="admin-add">
              <input
                placeholder="Title"
                value={newGame.title}
                onChange={e =>
                  setNewGame({ ...newGame, title: e.target.value })
                }
              />
              <input
                placeholder="Console"
                value={newGame.console}
                onChange={e =>
                  setNewGame({ ...newGame, console: e.target.value })
                }
              />
              <input
                type="number"
                placeholder="Price"
                value={newGame.price}
                onChange={e =>
                  setNewGame({ ...newGame, price: e.target.value })
                }
              />
              <button onClick={addGame}>Add Game</button>
            </div>
          )}

          {Object.keys(grouped).sort().map(letter => (
            <div key={letter}>
              <h2>{letter}</h2>
              <div className="grid">
                {grouped[letter].map(game => (
                  <div className="card" key={game.id}>
                    <strong>{game.title}</strong>
                    <div className="muted">{game.console}</div>

                    {admin ? (
                      <input
                        type="number"
                        value={game.price}
                        onChange={e =>
                          updatePrice(game.id, parseFloat(e.target.value))
                        }
                      />
                    ) : (
                      <div className="price">
                        ${game.price.toFixed(2)}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      );
    }

    ReactDOM
      .createRoot(document.getElementById("root"))
      .render(<App />);
  </script>
</body>
</html>
